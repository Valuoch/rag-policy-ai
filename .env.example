# Copy to .env and fill in. Without any LLM key the app runs in offline "extractive" mode.

# --- LLM (any OpenAI-compatible endpoint). Set ONE of these: ---------------
GROQ_API_KEY=                 # free tier: https://console.groq.com/keys  (default model llama-3.3-70b-versatile)
# OPENROUTER_API_KEY=         # free models: https://openrouter.ai/keys
# LLM_API_KEY=                # generic key; pair with LLM_BASE_URL
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODE=auto               # set to "extractive" to ignore any key

# --- Retrieval ---------------------------------------------------------------
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANK=true
# TOP_K=4
# FETCH_K=20
# MIN_RERANK_SCORE=-4.0
# MIN_SIMILARITY=0.50

# --- Chunking (words) -----------------------------------------------------
# CHUNK_SIZE=220
# CHUNK_OVERLAP=40

# --- Generation guardrails -----------------------------------------------
# MAX_ANSWER_TOKENS=350
# MAX_ANSWER_CHARS=1500
# LLM_TEMPERATURE=0

# --- Misc --------------------------------------------------------------------
# SEED=42
# USE_SYSTEM_CA=1             # trust the OS certificate store (corporate TLS proxies)
# PORT=8000
